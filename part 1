import random

def simulate_zkp(trials=20, knows_password=False):
    success_count = 0

    for _ in range(trials):
        path_entered = random.choice(['A', 'B'])
        challenge = random.choice(['A', 'B'])

        if knows_password:
            success = True  # Always passes if the prover knows the password
        else:
            success = path_entered == challenge  # Only passes if the guess matches the challenge

        if success:
            success_count += 1

    success_rate = success_count / trials
    print(f"Successful responses: {success_count}/{trials}")
    print(f"Success probability: {success_rate:.2%}")

# Simulate for a malicious prover (attacker)
simulate_zkp(trials=20, knows_password=False)
